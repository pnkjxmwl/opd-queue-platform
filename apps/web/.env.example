# Base URL of the NestJS API, used by SERVER code (server components, server
# actions, route handlers). Never exposed to the browser.
API_URL="http://localhost:3000"

# The same API, as the BROWSER must address it - for the realtime socket only
# (P7-WEB-01). It is a URL, not a secret; the credential is fetched separately from
# /api/socket-token and never stored. In a deployed environment this is the API's
# public origin, which is a different host from the console.
NEXT_PUBLIC_API_URL="http://localhost:3000"
