// OPD Queue Platform - core schema (Phases 0-4).
// Models here follow docs/Architecture.md 5.1. Payments arrived in Phase 5.
//
// docs/Rules.md 5:
//   - every tenant-scoped table has hospitalId and is indexed on it
//   - global tables are Account and Patient ONLY
//   - money in paise (Int), timestamps in UTC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Global (cross-hospital) entities
// ---------------------------------------------------------------------------

/// A login. Owns one or more Patient profiles, and may hold staff memberships.
model Account {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patients      Patient[]
  memberships   HospitalStaff[]
  doctor        Doctor?
  refreshTokens RefreshToken[]
  queueEntries  QueueEntry[]
  payments      Payment[]
  pushTokens    PushToken[]
  notifications Notification[]
}

/// The person actually receiving care - the account holder or a family member.
model Patient {
  id        String          @id @default(uuid())
  /// The account that owns this profile - null for a WALK-IN patient registered at
  /// reception, who has no app account at all (docs/PRD.md 6.3). Making this
  /// nullable is cheaper and more honest than the alternatives: inventing a shell
  /// Account per walk-in, attributing the patient to the receptionist's account
  /// (a lie in the data), or splitting a walk-in's name onto QueueEntry so the same
  /// person is modelled two different ways depending on how they arrived.
  accountId String?
  name      String
  dob       DateTime?
  gender    Gender?
  relation  PatientRelation @default(SELF)
  abhaId    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  account       Account?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  queueEntries  QueueEntry[]
  consultations Consultation[]

  @@index([accountId])
}

/// One issued refresh token.
///
/// Rotation: each use revokes the row and issues a successor in the same `familyId`.
/// Reuse detection: presenting an already-revoked token means it leaked, so the WHOLE
/// family is revoked and the session is killed rather than silently re-issued.
/// Only the SHA-256 of the token is stored - a database leak must not yield usable tokens.
model RefreshToken {
  id        String    @id @default(uuid())
  accountId String
  /// Shared by every token descended from one login. Revoked as a unit on reuse.
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Tenant-scoped entities
// ---------------------------------------------------------------------------

/// A tenant. Owns departments, doctors, staff and sessions.
model Hospital {
  id        String         @id @default(uuid())
  name      String
  city      String
  area      String?
  address   String?
  /// A photograph of the building, for discovery. Null is an ordinary state, not an
  /// error: a clinic that never uploads one must still render correctly, so every
  /// client falls back to the initials avatar rather than showing a broken image.
  /// Seeded for now; an upload path in the admin console comes later.
  photoUrl  String?
  status    HospitalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  departments Department[]
  doctors     Doctor[]
  staff       HospitalStaff[]
  schedules   DoctorSchedule[]
  sessions    OPDSession[]
  queuePolicy QueuePolicy?

  queueEntries  QueueEntry[]
  queueEvents   QueueEvent[]
  consultations Consultation[]
  auditLogs     AuditLog[]
  payments      Payment[]
  refunds       Refund[]

  @@index([city])
  @@index([status])
}

/// An account's membership in a hospital. This - not the Account - carries authority.
model HospitalStaff {
  id          String      @id @default(uuid())
  hospitalId  String
  accountId   String
  role        StaffRole
  permissions String[]    @default([])
  status      StaffStatus @default(ACTIVE)

  /// Outstanding invitation, if this membership is still INVITED.
  ///
  /// Only the SHA-256 of the token is stored - a database leak must not yield usable
  /// invitations, the same rule RefreshToken follows. Both columns are cleared the
  /// moment the invitation is accepted, so a token is single-use by construction
  /// rather than by a flag someone has to remember to check.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, accountId])
  @@index([hospitalId])
  @@index([accountId])
}

/// A unit within a hospital (e.g. Cardiology).
model Department {
  id         String   @id @default(uuid())
  hospitalId String
  name       String
  /// Config is deactivated, never deleted: doctors and sessions reference a
  /// department with onDelete: Restrict, so a hard DELETE stops working the day the
  /// department is first used - permanently. DELETE sets this false instead.
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors  Doctor[]
  sessions OPDSession[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

/// A provider who runs OPD sessions in a department.
model Doctor {
  id                 String   @id @default(uuid())
  hospitalId         String
  departmentId       String
  /// Set once the doctor is invited and has a login (Phase 1/2).
  accountId          String?  @unique
  name               String
  specialization     String?
  /// Portrait, for discovery. Nullable for the same reason as Hospital.photoUrl.
  photoUrl           String?
  /// Cold-start seed for the ETA engine (docs/Architecture.md 8).
  defaultConsultMins Int      @default(10)
  /// Deactivated, never deleted - see Department.isActive. A doctor who leaves the
  /// hospital still owns every past session, so the row can never be removed.
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)

  schedules          DoctorSchedule[]
  /// Sessions this doctor is booked for. Survives substitution (docs/PRD.md 8.11).
  sessionsAsOriginal OPDSession[]     @relation("SessionOriginalDoctor")
  /// Sessions this doctor is actually running right now.
  sessionsAsProvider OPDSession[]     @relation("SessionProvider")
  /// Consultations this doctor ACTUALLY performed - the provider, not the booked
  /// doctor, because this is the row the ETA engine learns durations from.
  consultations      Consultation[]

  @@index([hospitalId])
  @@index([departmentId])
}

/// A doctor's recurring or one-off working block, as clock times in Asia/Kolkata.
///
/// startTime/endTime are "HH:mm" strings, NOT DateTimes. A schedule is a rule about
/// clock faces; it becomes a UTC instant only when combined with a calendar date at
/// session-generation time. Zero-padded HH:mm compares lexicographically exactly as
/// it compares chronologically, so `endTime > startTime` is a real CHECK constraint.
///
/// ponytail: no SQL time arithmetic is possible on these columns. Nothing in the MVP
/// needs it (overlap detection would); switch to `@db.Time` if that changes.
model DoctorSchedule {
  id              String    @id @default(uuid())
  hospitalId      String
  doctorId        String
  /// 0=Sunday .. 6=Saturday, evaluated in Asia/Kolkata. Exclusive with `date`.
  weekday         Int?
  /// A single calendar date. Exclusive with `weekday`.
  date            DateTime? @db.Date
  startTime       String
  endTime         String
  /// Copied onto each generated session. docs/Phases.md: the fee belongs to the
  /// schedule/session, never the doctor - Phase 5 derives the amount from the session.
  defaultFeePaise Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor   Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  sessions OPDSession[]

  @@index([hospitalId])
  @@index([doctorId])
}

/// Per-hospital queue rules. ONE row per hospital.
///
/// This is the frozen input to the entire Phase-4 engine: every threshold the engine
/// uses is read from here, and the engine hardcodes none of them. Each column maps to
/// a locked rule in docs/PRD.md 8.
///
/// Columns carry NO database defaults on purpose - the defaults live once, in
/// `DEFAULT_QUEUE_POLICY` in packages/contracts. Two sets of defaults drift apart.
///
/// OPDSession deliberately holds NO queuePolicyId. hospitalId already determines the
/// policy (hospitalId is unique here), so a second pointer would be the same fact
/// twice - and two copies of one fact can disagree, which here would mean a session
/// running on another hospital's rules. The engine reads it by hospitalId.
model QueuePolicy {
  id         String @id @default(uuid())
  hospitalId String @unique

  /// PRD 8.3/8.5 - the policy, not the engine, owns ordering.
  orderingStrategy OrderingStrategy
  /// PRD 8.2 - only checked-in patients are callable.
  checkInRequired  Boolean
  /// PRD 8.6
  walkInEnabled    Boolean
  /// PRD 8.7
  priorityEnabled  Boolean

  /// PRD 8.8 - called, absent -> grace -> recall -> SKIPPED -> requeue.
  gracePeriodSec  Int
  recallAttempts  Int
  requeueBehavior RequeueBehavior

  /// PRD 8.12 - three INDEPENDENT registration limits, ANDed. Manual close is the
  /// third mechanism and lives per-session on OPDSession.registrationClosedAt.
  cutoffOnEtaOverrun  Boolean
  cutoffMinsBeforeEnd Int?
  maxOnlineTokens     Int?

  /// PRD 4.2 - "arrive N minutes before your window", the MVP stand-in for
  /// maps-based "leave now". Read by Phase 6/7 notifications.
  arriveBeforeMins Int

  /// Refund rules. JSON because refund tiers are the part most likely to grow; every
  /// field in the contracts schema defaults, so an old row still parses.
  cancellationRules Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

/// A doctor's working block on one date - the thing a queue belongs to.
///
/// `status` and `doctorPresence` are independent by design (docs/PRD.md 8.10): a
/// doctor being late, on a break, or gone never changes the session's status.
model OPDSession {
  id           String  @id @default(uuid())
  hospitalId   String
  departmentId String
  /// Provenance: set when generated from a schedule, null when created by hand.
  scheduleId   String?

  /// Who the session was booked with. Preserved across substitution (PRD 8.11).
  originalDoctorId        String
  /// Who is actually seeing patients. Equal to the original until substituted.
  currentProviderDoctorId String

  /// The Asia/Kolkata calendar date this session belongs to. Stored separately from
  /// the instants so "today's sessions" is an equality test rather than timezone
  /// arithmetic on every discovery query.
  date           DateTime @db.Date
  /// UTC instants, derived from `date` plus the schedule's clock times.
  scheduledStart DateTime
  scheduledEnd   DateTime

  status         SessionStatus  @default(OPEN_FOR_REGISTRATION)
  doctorPresence DoctorPresence @default(NOT_PRESENT)

  /// Prefix for token labels, e.g. "A" -> "A027".
  tokenPrefix          String    @default("A")
  feePaise             Int
  /// Set when staff manually close registration (PRD 8.12, third mechanism).
  registrationClosedAt DateTime?
  /// Set while the queue is paused, cleared on resume (docs/PRD.md 6.2).
  ///
  /// A nullable timestamp rather than a SessionStatus value: a paused session is
  /// still ACTIVE - it has not ended and it still accepts joins and check-ins - so
  /// adding PAUSED to the status enum would force every existing status check to
  /// learn a new value in order to keep behaving the same. It also records WHEN,
  /// which a status cannot, and it matches registrationClosedAt directly above.
  pausedAt             DateTime?
  /// Bumped by Phase-4 commands so clients can drop a stale realtime snapshot.
  version              Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  schedule        DoctorSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  originalDoctor  Doctor          @relation("SessionOriginalDoctor", fields: [originalDoctorId], references: [id], onDelete: Restrict)
  currentProvider Doctor          @relation("SessionProvider", fields: [currentProviderDoctorId], references: [id], onDelete: Restrict)

  entries QueueEntry[]
  events  QueueEvent[]

  /// Idempotency for generate-from-schedule, as a DATABASE constraint rather than an
  /// application check - staff will double-click, and an application check loses that
  /// race (docs/Phases.md, docs/Rules.md 5).
  @@unique([originalDoctorId, date, scheduledStart])
  @@index([hospitalId, date])
  @@index([hospitalId, status])
  @@index([departmentId])
  @@index([scheduleId])
}

// ---------------------------------------------------------------------------
// Queue engine (Phase 4) - docs/Architecture.md 7
// ---------------------------------------------------------------------------

/// One patient's place in one session's queue.
///
/// `tokenNumber` is an immutable booking-order LABEL, not the call order
/// (docs/PRD.md 8.1). The effective call order is computed on every read from
/// status + priority + priorityAt + tokenNumber and is deliberately NOT stored:
/// a stored order is wrong the instant anyone checks in, is skipped, or is escalated.
model QueueEntry {
  id         String  @id @default(uuid())
  hospitalId String
  sessionId  String
  patientId  String
  /// The account that booked. Null for a walk-in registered at reception.
  accountId  String?

  /// Unique within the session by DATABASE constraint, not an application check -
  /// two staff registering a walk-in at the same instant is a race an application
  /// check loses (docs/Rules.md 5).
  tokenNumber Int
  /// tokenPrefix + zero-padded tokenNumber, e.g. "A027". Denormalised because it is
  /// on every card and notification, and the prefix can be edited afterwards.
  tokenLabel  String

  /// How the entry got here. Provenance, and never rewritten - see the note on
  /// QueueEntryType in packages/contracts/src/enums/queue.ts.
  type       QueueEntryType
  /// Audited escalation (docs/PRD.md 8.7), independent of `type`.
  priority   QueueEntryPriority @default(NORMAL)
  /// When `priority` was last raised. Breaks ties between two emergencies in the
  /// order they were escalated; null whenever priority is NORMAL.
  priorityAt DateTime?

  /// No default: an online join starts RESERVED and a walk-in starts CHECKED_IN, so
  /// a default would be wrong half the time. Every creator states it.
  status QueueEntryStatus

  /// Signed, opaque QR reference (docs/Rules.md 10) - no PII, not enumerable.
  /// Issued with the token (Phase 5); the signing scheme itself is Phase 6.
  checkInCode String? @unique

  /// Times this entry was called and did not appear. Compared against
  /// QueuePolicy.recallAttempts (docs/PRD.md 8.8); never hardcoded in a command.
  recallCount Int @default(0)

  /// When an unpaid RESERVED hold lapses (docs/PRD.md 10). Null for every entry
  /// that never needed one - a walk-in, and anything already paid for.
  ///
  /// **This column, not a job, is what releases the slot.** Every rule that counts
  /// people in a session treats a RESERVED entry past this instant as not holding a
  /// place, so the slot frees at exactly the right moment even if no worker is
  /// running. The sweeper only writes down what is already true.
  reservationExpiresAt DateTime?

  /// The ETA window this patient was SHOWN when the "leave now" push was sent, so
  /// the promise can be compared with `calledAt` afterwards. Written once, never
  /// updated: the point is what we committed to at the moment they acted on it, not
  /// the estimate as it drifted.
  ///
  /// Two columns rather than one because a window is what the patient sees - grading
  /// a midpoint invented after the fact would measure something nobody was told.
  /// Null means no nudge was ever sent, which is honest rather than a zero score.
  predictedCallFrom DateTime?
  predictedCallTo   DateTime?

  joinedAt         DateTime  @default(now())
  checkedInAt      DateTime?
  /// Set when a skipped patient is put back in the pool (docs/PRD.md 8.8,
  /// RequeueBehavior.END_OF_QUEUE). It is what "move to end" MEANS in a model where
  /// the call order is computed and the token number is immutable: requeued entries
  /// sort after everyone who has not been requeued, then among themselves by when
  /// they were requeued. Without it, a skipped patient with an early token is
  /// offered to the doctor again immediately - the loop the grace period exists to
  /// stop. Null for everyone who has never been skipped.
  requeuedAt       DateTime?
  calledAt         DateTime?
  consultStartedAt DateTime?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  session       OPDSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  events        QueueEvent[]
  consultation  Consultation?
  payment       Payment?
  notifications Notification[]

  @@unique([sessionId, tokenNumber])
  @@index([hospitalId])
  /// The call-order scan and the per-card status groupBy both key off this.
  @@index([sessionId, status])
  @@index([accountId])
  @@index([patientId])
}

/// The append-only queue timeline (docs/Rules.md 5, 7).
///
/// Never updated and never deleted - a mistake is corrected with a compensating
/// event, not an edit. There is intentionally no `updatedAt`: a column nothing may
/// change should not exist. This is also the raw data the ETA engine learns from.
model QueueEvent {
  id         String  @id @default(uuid())
  hospitalId String
  sessionId  String
  /// Null for session-level events (paused, ended, presence changed).
  entryId    String?

  type      QueueEventType
  /// Who acted. actorId is the Account id, and is null only when actorType is
  /// SYSTEM (a background job).
  actorType ActorType
  actorId   String?

  /// Event-specific payload - the from/to states, a reason, a recall attempt number.
  /// Json because the useful detail differs per event type and none of it is queried.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  hospital Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  session  OPDSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  entry    QueueEntry? @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([entryId])
}

/// Who did what, when, and why (docs/Rules.md 1.7). Append-only, like QueueEvent.
///
/// Separate from QueueEvent on purpose: QueueEvent is the queue's own timeline and
/// is read by patients and the ETA engine, while this is the accountability record
/// and covers actions with no queue at all (config edits, staff invitations). The
/// same action writes one of each.
model AuditLog {
  id         String  @id @default(uuid())
  /// Null for platform-level actions that belong to no tenant.
  hospitalId String?

  actorType ActorType
  actorId   String?

  /// The command name, e.g. "queue.callNext".
  action     String
  entityType String
  entityId   String
  /// Required by the caller for actions docs/PRD.md 8.7 says must carry one.
  reason     String?
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([entityType, entityId])
}

/// One completed consultation. Written by complete-consultation, and the source the
/// ETA engine learns real durations from (docs/Architecture.md 8).
model Consultation {
  id           String @id @default(uuid())
  hospitalId   String
  queueEntryId String @unique
  patientId    String
  /// The doctor who ACTUALLY saw the patient - the session's current provider, not
  /// the booked doctor (docs/PRD.md 8.11). Attributing a substitute's timings to the
  /// absent doctor would poison both doctors' averages.
  doctorId     String

  startedAt   DateTime
  endedAt     DateTime
  /// Denormalised endedAt - startedAt. The ETA engine averages this on the hot path
  /// and should not compute an interval per row to do it.
  durationSec Int

  createdAt DateTime @default(now())

  hospital Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  entry    QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)
  patient  Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor   Doctor     @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  /// The ETA blend: this doctor's all-time average and today's running average.
  @@index([doctorId, endedAt])
  @@index([patientId])
}

// ---------------------------------------------------------------------------
// Payments (Phase 5) - docs/Architecture.md 10, docs/Rules.md 9
// ---------------------------------------------------------------------------

/// One patient's payment for one place in a queue.
///
/// **Financial history: append-only in spirit.** Rows here are corrected with a
/// compensating `Refund`, never edited into a different story and never deleted
/// (docs/Phases.md Phase 5, "if it goes wrong"). `status` does advance, because it
/// tracks a real external lifecycle, but the Razorpay ids that prove what happened
/// are written once.
///
/// `amountPaise` is derived from `OPDSession.feePaise` at join time and is stored
/// so a later fee change cannot rewrite what someone actually paid.
model Payment {
  id           String @id @default(uuid())
  hospitalId   String
  /// One order per reservation. A retry re-uses this order rather than creating a
  /// second one, which is what stops a flaky connection charging someone twice.
  queueEntryId String @unique
  /// Who paid. Always an app account - a walk-in pays at the desk and has no row here.
  accountId    String

  amountPaise Int
  currency    String        @default("INR")
  status      PaymentStatus @default(CREATED)

  razorpayOrderId   String  @unique
  /// **The replay guard.** A duplicate `payment.captured` hits this constraint, and
  /// the handler treats the violation as success rather than an error - which is
  /// exactly what docs/Phases.md asks for: an application check loses that race, a
  /// unique index does not (docs/Rules.md 5).
  razorpayPaymentId String? @unique
  /// The HMAC on the webhook we accepted. Evidence of what was verified, not a
  /// credential: it is a signature OVER a public payload and grants nothing.
  razorpaySignature String?

  /// Sum of every refund raised. Kept here so "how much is left" needs no aggregate
  /// on the cancel path, and so PARTIALLY_REFUNDED has a number behind it.
  refundedPaise Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  entry    QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)
  /// Restrict, unlike QueueEntry.account: an account with money against it cannot be
  /// deleted out from under its own payment record.
  account  Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  refunds  Refund[]

  @@index([hospitalId])
  @@index([accountId])
  /// The reservation sweeper and Phase 8's payment-reconcile both scan by status.
  @@index([status])
}

/// One refund raised against one payment.
///
/// Separate rows rather than a field on Payment because a payment can be refunded
/// more than once (partial, then the rest) and because a refund has its OWN
/// asynchronous lifecycle - `PENDING` means Razorpay accepted the request, not that
/// the patient has their money back.
model Refund {
  id         String @id @default(uuid())
  hospitalId String
  paymentId  String

  amountPaise      Int
  status           RefundStatus @default(PENDING)
  razorpayRefundId String?      @unique
  /// Why, in words, for the patient and for the audit trail. Never optional: a
  /// refund with no reason is unanswerable three months later.
  reason           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientRelation {
  SELF
  SPOUSE
  MOTHER
  FATHER
  CHILD
  SIBLING
  OTHER
}

enum HospitalStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum StaffRole {
  ADMIN
  RECEPTION
  DOCTOR
}

enum StaffStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// docs/PRD.md 8.10. Independent of DoctorPresence.
enum SessionStatus {
  SCHEDULED
  OPEN_FOR_REGISTRATION
  ACTIVE
  COMPLETED
  CANCELLED
  ENDED_EARLY
}

/// docs/PRD.md 8.10. Independent of SessionStatus.
enum DoctorPresence {
  NOT_PRESENT
  PRESENT
  ON_BREAK
  LEFT
}

/// docs/PRD.md 8.3 pins v1 to token order. One value is deliberate: the column gives
/// the decision a home (PRD 8.5 says the policy decides ordering), and adding a value
/// later is an additive ALTER TYPE.
enum OrderingStrategy {
  TOKEN_ORDER
}

/// docs/PRD.md 8.8 - what happens after grace and every recall attempt is spent.
enum RequeueBehavior {
  END_OF_QUEUE
  NO_REQUEUE
}

/// docs/PRD.md 7.3. READY is reserved and unreachable in v1 - see the note in
/// packages/contracts/src/enums/queue.ts. Legal transitions live in the Phase-4
/// state machine, never here.
enum QueueEntryStatus {
  RESERVED
  CONFIRMED
  VIRTUAL_WAITING
  CHECKED_IN
  READY
  CALLED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  SKIPPED
  RESCHEDULED
}

/// How an entry got into the queue. Immutable provenance. docs/PRD.md 8.5 lists
/// PRIORITY/EMERGENCY here too; this build keeps them in QueueEntryPriority so an
/// escalated walk-in is still recorded as a walk-in.
enum QueueEntryType {
  ONLINE
  WALK_IN
  FOLLOW_UP
}

/// Audited escalation. docs/PRD.md 8.7.
enum QueueEntryPriority {
  NORMAL
  PRIORITY
  EMERGENCY
}

/// Who performed an action. SYSTEM is a background job and the only value whose
/// actor id is null.
enum ActorType {
  PATIENT
  STAFF
  DOCTOR
  SYSTEM
}

/// The append-only queue timeline. One value per thing that can happen, not one per
/// endpoint: actorType is what distinguishes a human skip from the grace-expiry job.
/// Phase 5 added the join/payment events as an additive ALTER TYPE.
enum QueueEventType {
  ENTRY_RESERVED
  ENTRY_CONFIRMED
  ENTRY_CANCELLED
  ENTRY_CHECKED_IN
  ENTRY_CALLED
  ENTRY_RECALLED
  ENTRY_CONSULTATION_STARTED
  ENTRY_CONSULTATION_COMPLETED
  ENTRY_SKIPPED
  ENTRY_NO_SHOW
  ENTRY_REQUEUED
  ENTRY_PRIORITY_CHANGED
  ENTRY_RESCHEDULED
  WALK_IN_ADDED
  SESSION_ACTIVATED
  SESSION_PAUSED
  SESSION_RESUMED
  SESSION_ENDED
  SESSION_REGISTRATION_CLOSED
  DOCTOR_PRESENCE_CHANGED
}

/// docs/PRD.md 10. Deliberately NOT merged into QueueEntryStatus - see the note on
/// PaymentStatus in packages/contracts/src/enums/payment.ts.
enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

/// A device this account can be reached on (P8-DB-01).
///
/// The token is Expo's, opaque and device-specific. UNIQUE on the token itself, not
/// on (accountId, token): the same physical device can be handed to a different
/// person, and Expo will then route the old account's pushes to the new one unless
/// re-registering MOVES the token rather than duplicating it.
model PushToken {
  id        String  @id @default(uuid())
  accountId String
  token     String  @unique
  platform  String?

  /// Set when Expo tells us the device is gone (`DeviceNotRegistered`). Kept rather
  /// than deleted so a device that comes back is recognised, and so the delivery
  /// rate can be measured against something (docs/Phases.md: dead tokens are how a
  /// delivery rate "quietly rots").
  disabledAt DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([disabledAt])
}

/// One thing we told, or tried to tell, one patient (P8-DB-01).
///
/// **A row is written first and sent afterwards.** The dispatcher is a sweep over
/// PENDING rows, so a push survives a process restart between the queue command and
/// the send - which a fire-and-forget call inside the command would not. It is also
/// the history docs/Architecture.md 13 asks for, and the idempotency key.
model Notification {
  id        String  @id @default(uuid())
  accountId String
  /// The booking this is about. Null only for an account-level message.
  entryId   String?

  type  String
  title String
  body  String
  /// Deep-link payload the app reads on tap. Small by design - no PII (docs/Rules.md 8).
  data  Json?

  status    String    @default("PENDING")
  attempts  Int       @default(0)
  sentAt    DateTime?
  /// Why the last attempt failed. For operators; never shown to a patient.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entry   QueueEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// **The storm guard, as a database constraint rather than an application check**
  /// (docs/Rules.md 5). "You are getting close" must fire once per patient per
  /// booking, and the ETA tick runs every minute - an app-level check loses that race
  /// the first time two ticks overlap. A duplicate insert violates this and is
  /// treated as "already told them".
  @@unique([entryId, type])
  @@index([status, createdAt])
  @@index([accountId])
}
