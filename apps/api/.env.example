# Copy to .env and fill in. NEVER commit .env (docs/Rules.md 1.5).
NODE_ENV=development
PORT=3000

# Ports match docker-compose.yml (non-default on purpose).
DATABASE_URL="postgresql://opd:opd_local_dev@localhost:5433/opd?schema=public"
REDIS_URL="redis://localhost:6380"

LOG_LEVEL=info

# Auth. Generate real ones with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-32+-random-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-32+-chars"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Signs the check-in QR code (Phase 6). Generate one the same way as the JWT secrets.
# Changing it invalidates every token QR already in a patient’s hand.
CHECKIN_SECRET="replace-me-with-another-32+-chars"

# Comma-separated Google OAuth client ids (ios,android,web). Empty = /auth/google disabled.
GOOGLE_CLIENT_IDS=""

# Razorpay TEST mode (docs/Rules.md 9). Empty = /sessions/:id/join is disabled and
# says so; everything else still runs. Get these from the Razorpay test dashboard:
#   Settings > API Keys        -> key id + secret
#   Settings > Webhooks > Add  -> URL = <your tunnel>/webhooks/razorpay, and the
#                                 secret you type there is RAZORPAY_WEBHOOK_SECRET.
# Subscribe the webhook to: payment.captured, payment.failed, refund.processed.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# The publicly reachable origin of this API - your tunnel in dev. Razorpay
# redirect-mode returns the browser here after payment. Empty still works, but
# netbanking and wallets are more fragile without it.
PUBLIC_BASE_URL=""

# How long an unpaid reservation holds its slot, in seconds.
RESERVATION_TTL_SEC=600

# Error reporting. Empty disables it entirely, which is the state for Phase 9 - the
# PII scrubber (src/common/scrub.ts) ships and is tested now so that switching this
# on later is a config change rather than a compliance decision made in a hurry.
SENTRY_DSN=
