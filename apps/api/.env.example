# Copy to .env and fill in. NEVER commit .env (docs/Rules.md 1.5).
NODE_ENV=development
PORT=3000

# Ports match docker-compose.yml (non-default on purpose).
DATABASE_URL="postgresql://opd:opd_local_dev@localhost:5433/opd?schema=public"
REDIS_URL="redis://localhost:6380"

LOG_LEVEL=debug

# Auth. Generate real ones with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-32+-random-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-32+-chars"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Comma-separated Google OAuth client ids (ios,android,web). Empty = /auth/google disabled.
GOOGLE_CLIENT_IDS=""
