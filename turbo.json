{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  // Turbo 2 runs tasks in a FILTERED environment: anything not declared here is
  // stripped before the task sees it. Locally this went unnoticed because
  // process.loadEnvFile() reads apps/api/.env directly, bypassing Turbo entirely -
  // but CI has no .env, so every var vanished and env validation refused to boot.
  // passThrough (not globalEnv) so rotating a secret does not invalidate the cache.
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "PORT",
    "LOG_LEVEL",
    "SENTRY_DSN",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_TTL_SEC",
    "JWT_REFRESH_TTL_SEC",
    "CHECKIN_SECRET",
    "GOOGLE_CLIENT_IDS",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    "PUBLIC_BASE_URL",
    "RESERVATION_TTL_SEC",
    "API_URL",
    "EXPO_PUBLIC_API_URL",
    "NEXT_PUBLIC_API_URL",
    "DISABLED_WORKERS",
    "EXPO_ACCESS_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      // `build` as well as `^build`: apps/web's test starts a server, and Next
      // cannot build and serve the same .next directory at once - turbo running
      // `next build` beside it left the console unable to start at all (trap 30).
      // Depending on its own build also means the suite exercises what ships.
      "dependsOn": ["^build", "build"]
    },
    "clean": { "cache": false }
  }
}
