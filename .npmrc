# Isolated (pnpm default) linking is REQUIRED here: apps/web needs React 19
# (Next 15 App Router) while apps/mobile is pinned to React 18.3.1 by Expo SDK 52.
# A hoisted layout forces one React on both and breaks whichever loses.
#
# Consequence: pnpm's store holds both @types/react versions, so apps/mobile pins
# its React typings explicitly via `paths` in apps/mobile/tsconfig.json, and Metro
# resolves the workspace via apps/mobile/metro.config.js.
strict-peer-dependencies=false
auto-install-peers=true

# Windows MAX_PATH. The default virtual-store-dir-max-length is 120, which puts
# paths like
#   node_modules/.pnpm/<120 chars>/node_modules/expo-modules-core/android/build/
#   intermediates/cxx/Debug/<hash>/logs/arm64-v8a/prefab_command.bat
# at 272 characters. Windows CreateProcess caps at 260, so Gradle's CMake step
# fails with "Could not start ..." on any native module - the Android build
# cannot complete at all.
#
# Shortening the directory names is the fix that keeps isolated linking; hoisting
# would also work but is ruled out by the React version split above.
virtual-store-dir-max-length=50
